# Copy this file to .env and fill in real values. .env is gitignored; this file is not.

# Warehouse Postgres connection (used by extract.py, dbt profiles.yml, and Airflow).
# These values are the CONTAINER-side address: Astro CLI auto-injects .env into
# every Airflow container, so this is what the DAG (and dbt, once it runs there)
# use. extract.py falls back to localhost:5433 in its own code when these env
# vars aren't set - so running it directly from the laptop works as long as you
# DON'T `source .env` into that shell first.
# Day 5B finding: `astro dev start` does NOT forward .env into
# docker-compose.override.yml's ${WAREHOUSE_USER}/etc. interpolation (plain
# `docker compose` from this directory does - confirmed directly). That file
# now has matching hardcoded defaults, so this only matters if you invoke
# docker compose yourself directly.
WAREHOUSE_HOST=warehouse
WAREHOUSE_PORT=5432
WAREHOUSE_USER=postgres
WAREHOUSE_PASSWORD=postgres
WAREHOUSE_DB=warehouse

# Airflow connection to the warehouse, read by the DAG instead of the Airflow UI
AIRFLOW_CONN_WAREHOUSE=postgres://postgres:postgres@warehouse:5432/warehouse

# Day 2: where extract.py caches the downloaded source file and the per-date
# NL-filtered parquet. Empty/unset -> defaults to data/raw (repo-relative),
# which is correct for laptop runs. Inside the Airflow containers, .env sets
# this to a container-local path (e.g. /usr/local/airflow/data/raw) that isn't
# one of the host-bind-mounted dags/include/plugins folders, so the cache never
# touches host files - it's just lost on the next `astro dev restart`.
EXTRACT_CACHE_DIR=

# DuckDB's memory cap for the extract stage, so it can't OOM the container.
DUCKDB_MEMORY_LIMIT=2GB

# Hugging Face read-only access token (huggingface.co/settings/tokens), used by
# include/extract/extract.py. Unauthenticated requests hit a low rate limit that
# reading food.parquet's row groups over the network exceeds; authenticated
# requests get a much higher quota.
HF_TOKEN=

# Local-dev-only override: Airflow disables `connections test` by default (an
# SSRF-hardening default since 2.7+). Safe here since this is a throwaway local
# stack; would NOT enable this in a shared/production Airflow deployment.
AIRFLOW__CORE__TEST_CONNECTION=Enabled

# Day 5B finding: Airflow pauses every DAG by default on first sight, and a
# manually triggered run of a paused DAG creates the DagRun but never
# schedules its tasks (confirmed directly - they sit with no state until the
# DAG is unpaused). Without this, "trigger the DAG" needs an extra manual
# unpause first, breaking the three-command quickstart promise.
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=False
